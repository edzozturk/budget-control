# Budget Control configuration. Copy to .env and adjust.
# Every value is optional; the defaults below are used when a value is missing.

# Network. 127.0.0.1 keeps the app reachable only from this computer.
# Use 0.0.0.0 to open it to other devices on your network (e.g. your phone) or in a container.
HOST=127.0.0.1
PORT=4310

# Where the encrypted database and backups live.
DATA_DIR=./data

# Database driver. "sqlite" = local encrypted file (SQLCipher). "postgres" is planned for cloud installs.
DB_DRIVER=sqlite
DB_FILE=budget.db

# Branding and defaults for a fresh install.
APP_NAME=Budget Control
DEFAULT_LOCALE=tr
DEFAULT_CURRENCY=TRY

# Lock the app after this many minutes without activity.
SESSION_IDLE_MINUTES=30

# Set to true when serving over HTTPS (cloud), so the session cookie is marked Secure.
COOKIE_SECURE=false
